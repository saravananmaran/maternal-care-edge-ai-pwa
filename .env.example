# =============================================================================
# MaternalCare Edge AI - Environment Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to `.env` in the project root: `cp .env.example .env`
# 2. Fill in your AWS credentials and S3 bucket name.
# 3. Alternatively, you can configure these directly in the app's Settings modal.
# =============================================================================

# AWS Region where your S3 bucket resides
VITE_AWS_REGION=us-east-1

# S3 Bucket Name configured for receiving patient risk JSON objects
VITE_AWS_BUCKET_NAME=maternal-health-records-edge-sync

# IAM User Access Key ID (Requires s3:PutObject permission on the bucket)
VITE_AWS_ACCESS_KEY_ID=

# IAM User Secret Access Key
VITE_AWS_SECRET_ACCESS_KEY=

# AWS STS Session Token (Optional: only needed if using temporary credentials)
VITE_AWS_SESSION_TOKEN=

# Simulation Mode:
# Set to 'false' to enforce real AWS S3 network uploads.
# When 'true' (default), mock uploads succeed locally if IAM keys are not provided.
VITE_AWS_ENABLE_SIMULATION=true

